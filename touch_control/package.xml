<?xml version="1.0"?>
<package format="3">
  <name>touch_control</name>
  <version>1.0.0</version>
  <description>ROS package for interfacing with 3D Systems Touch haptic devices.</description>
  <maintainer email="kils@mmmi.sdu.dk">Kim Lindberg Schwaner</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libboost-dev</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>touch_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
